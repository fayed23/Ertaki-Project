# Copy to .env and fill before `docker compose up`.
# Never commit real secrets.

# --- Required in production ---
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
POSTGRES_USER=ertaki
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=ertaki

# Composed DATABASE_URL (api service). Override if needed.
# DATABASE_URL=postgres://ertaki:change-me-strong-db-password@postgres:5432/ertaki

# Public hostnames for Caddy (TLS). Use localhost for HTTP-only local compose.
DOMAIN=localhost
# Email for Let's Encrypt when DOMAIN is a real public hostname:
ACME_EMAIL=admin@example.com

# Admin Next.js public API URL (browser → reverse proxy)
NEXT_PUBLIC_API_URL=http://localhost/api

# Optional
# FCM_SERVER_KEY=
# SEED_ON_EMPTY=true
# LOG_LEVEL=info
