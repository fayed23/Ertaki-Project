# Copy to .env and fill before `docker compose up`.
# Never commit real secrets.

# --- Required in production ---
NODE_ENV=production
# Generate a unique secret (≥32 chars). Do NOT use the placeholder text below.
JWT_SECRET=
POSTGRES_USER=ertaki
POSTGRES_PASSWORD=
POSTGRES_DB=ertaki

# Composed DATABASE_URL (api service). Override if needed.
# DATABASE_URL=postgres://ertaki:YOUR_STRONG_PASSWORD@postgres:5432/ertaki

# Public hostnames for Caddy (TLS). Use localhost for HTTP-only local compose.
DOMAIN=localhost
# Email for Let's Encrypt when DOMAIN is a real public hostname:
ACME_EMAIL=admin@example.com

# Admin Next.js public API URL (browser → reverse proxy)
NEXT_PUBLIC_API_URL=http://localhost/api

# Browser CORS allow-list (comma-separated). Required for admin UI in production.
# Example: https://your.domain,http://localhost:43123
CORS_ORIGINS=

# JWT access-token lifetime (default 12h)
JWT_EXPIRES_IN=12h

# Demo seed accounts (password123) — off by default in production compose.
SEED_ON_EMPTY=false
ALLOW_DEMO_SEED=false

# Optional
# FCM_SERVER_KEY=
# LOG_LEVEL=info
